# Settings for PS5 Agent Remote. Values live in .env.local (ignored by git).
# The server reads .env.local itself. If varlock (https://varlock.dev) is
# installed, start.cmd runs the server through `varlock run` instead.
# @defaultSensitive=false @defaultRequired=false
# ---

# PlayStation Network NPSSO sign-in token, 64 characters. Get it while signed
# in at playstation.com from https://ca.account.sony.com/api/v1/ssocookie.
# Lasts about 2 months. The remote page's sign-in step writes it here.
# @sensitive
PSN_NPSSO=

# PS5 IP address. Leave empty to find the console automatically.
PS5_HOST=
